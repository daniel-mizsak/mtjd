{
  // Base settings
  "chat.viewSessions.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.dragAndDrop": false,
  "editor.emptySelectionClipboard": false,
  "editor.fontFamily": "MesloLGS Nerd Font Mono",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.inlayHints.enabled": "off",
  "editor.lineHeight": 1.55,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.mouseWheelScrollSensitivity": 0.8,
  "explorer.sortOrderLexicographicOptions": "upper",
  "extensions.autoUpdate": false,
  "files.associations": {
    "**/ansible/**/*.yml": "ansible",
    "**/tasks/*.yml": "ansible",
  },
  "files.eol": "\n",
  "files.exclude": {
    // Ansible
    "**/.ansible": true,
    // Python
    "**/__pycache__": true,
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.allowForcePush": true,
  "git.blame.editorDecoration.enabled": true,
  "git.confirmForcePush": false,
  "git.confirmSync": false,
  "git.replaceTagsWhenPull": true,
  "git.suggestSmartCommit": false,
  "search.exclude": {
    "**/.venv": true,
  },
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.enableKittyKeyboardProtocol": false,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.suggest.enabled": false,
  "window.zoomLevel": -0.35,
  "workbench.colorTheme": "Dark+",
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook",
  },
  "workbench.editor.wrapTabs": true,
  "workbench.enableExperiments": false,
  "workbench.settings.editor": "json",
  "workbench.settings.openDefaultSettings": true,
  "workbench.sideBar.location": "left",
  // Extensions
  /*
  .NET Install Tool
  Ansible
  autoDocstring - Python Docstring Generator
  Bash IDE
  Better Comments
  Better JSON5
  C#
  C# Dev Kit
  Code Spell Checker
  CodeRabbit
  CodeSnap
  Container Tools
  CSharpier - Code formatter
  Dev Containers
  Docker DX
  Even Better TOML
  Fish
  Github Actions
  GitHub Pull Requests
  Go
  hadolint
  indent-rainbow
  LaTeX Workshop
  Live Share
  Lua
  marimo
  markdownlint
  Nix IDE
  PowerShell
  Prettier - Code formatter
  psioniq File Header
  Pylance
  Python
  Python Debugger
  Python Environments
  Rainbow CSV
  Remote - SSH
  Remote - SSH: Editing Configuration Files
  Remote Explorer
  Ruff
  Tailwind CSS IntelliSense
  ty
  VSCode Neovim
  vscode-just
  WSL
  YAML
  zizmor
  */
  // .NET Install Tool
  "dotnetAcquisitionExtension.enableTelemetry": false,
  // Ansible
  "ansible.lightspeed.enabled": false,
  "ansible.python.interpreterPath": "${workspaceFolder}/.venv/bin/python",
  "redhat.telemetry.enabled": false,
  // Bash IDE
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
  },
  "bashIde.shfmt.spaceRedirects": true,
  // C#
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
  },
  "csharp.experimental.debug.hotReload": true,
  // Code Spell Checker
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.diagnosticLevelFlaggedWords": "Hint",
  // CodeSnap
  "codesnap.containerPadding": "1em",
  "codesnap.showWindowControls": false,
  // Docker
  "[dockerfile]": {
    "editor.tabSize": 4,
  },
  "docker.extension.enableComposeLanguageServer": true,
  // Even Better TOML
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.tabSize": 2,
  },
  "evenBetterToml.formatter.indentEntries": true,
  "evenBetterToml.formatter.indentTables": true,
  // Fish
  "[fish]": {
    "editor.defaultFormatter": "bmalehorn.vscode-fish",
  },
  // GitHub Actions
  "[github-actions-workflow]": {
    "editor.tabSize": 2,
  },
  // GitHub Copilot
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.enable": {
    "markdown": true,
  },
  // Go
  "[go][go.mod]": {
    "editor.defaultFormatter": "golang.go",
  },
  // indent-rainbow
  "indentRainbow.includedLanguages": [
    "ansible",
    "css",
    "github-actions-workflow",
    "json",
    "jsonc",
    "yaml",
    "yml",
  ],
  // Javascript
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.rulers": [80],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },
  // Just
  "[just]": {
    "editor.defaultFormatter": "nefrob.vscode-just-syntax",
  },
  // Lua
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua",
  },
  // Nix IDE
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
  },
  // PowerShell
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
  },
  "powershell.powerShellAdditionalExePaths": {
    "pwsh": "/run/current-system/sw/bin/pwsh",
  },
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.startAutomatically": false,
  // psioniq File Header
  "psi-header.config": {
    "author": "Daniel Mizsak",
    "authorEmail": "daniel@mizsak.com",
    "blankLinesAfter": 1,
    "forceToTop": true,
  },
  "psi-header.lang-config": [
    {
      "language": "python",
      "begin": "\"\"\"",
      "end": "\"\"\"",
    },
  ],
  "psi-header.templates": [
    {
      "language": "python",
      "template": [
        "Short description and source of base code.",
        "",
        "@author \"<<author>>\" <<<authoremail>>>",
      ],
    },
  ],
  // Python
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.sortMembers": "explicit",
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.defaultFoldingRangeProvider": "charliermarsh.ruff",
    "editor.rulers": [80, 120],
  },
  "python-envs.terminal.autoActivationType": "off",
  "python.experiments.enabled": false,
  "python.languageServer": "None",
  // Remote - SSH
  "remote.SSH.remotePlatform": {
    "*": "linux",
    "nixos": "linux",
  },
  // Ruff
  "ruff.fixAll": false,
  "ruff.lineLength": 120,
  "ruff.nativeServer": "on",
  // VSCode Neovim
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  // YAML
  "[yaml]": {
    "editor.tabSize": 2,
  },
  "githubPullRequests.pullBranch": "never",
}
